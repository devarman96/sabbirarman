{
  "entities": {
    "Message": {
      "title": "Contact Message",
      "description": "Messages sent through the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Sender name" },
        "email": { "type": "string", "description": "Sender email" },
        "message": { "type": "string", "description": "Message content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Time sent" }
      },
      "required": ["name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "messages": {
      "schema": "Message",
      "description": "Collection of messages from users"
    }
  }
}
